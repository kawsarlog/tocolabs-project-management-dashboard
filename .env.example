# Local dev (SQLite) — sheet/ledger data still lives here
DATABASE_URL="file:./ledger-dev.db"
# On Vercel, file: URLs are remapped to /tmp/tocolabs-ledger.db automatically.

# Supabase Auth (required)
# Copy values into .env.local — do not commit secrets.
NEXT_PUBLIC_SUPABASE_URL="https://YOUR_PROJECT_REF.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-anon-or-publishable-key"

# Server-only. Used when a business admin creates/resets/deletes employees.
# Never prefix this with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"

# Run dashboard-app/supabase/schema.sql in the Supabase SQL Editor.
# Turn OFF Authentication → Email → Confirm email.

